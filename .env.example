# ============================================================
# CLIENT-SIDE (safe to expose — embedded in the JS bundle)
# Only put PUBLIC keys here. Anything prefixed with VITE_ ships
# to the browser.
# ============================================================
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# ============================================================
# SERVER-SIDE (Supabase Edge Function secrets)
# Set these via the Supabase Dashboard (Project → Settings →
# Edge Functions → Secrets) or `supabase secrets set NAME=value`.
# DO NOT add a VITE_ prefix — they must NEVER reach the browser.
# ============================================================
# GEMINI_API_KEY=your_google_gemini_key
# W_API_INSTANCE=your_w_api_instance_id
# W_API_TOKEN=your_w_api_token
# ALLOWED_ORIGINS=https://app.example.com,http://localhost:8087
